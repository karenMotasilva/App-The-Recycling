{
  "expo": {
    "name": "The Recycling",
    "slug": "the-recycling",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-image.png",
      "resizeMode": "contain",
      "backgroundColor": "#EFF7F8"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#EFF7F8"
      }
    },
    "plugins": [
      "expo-splash-screen"
    ]
  }
}
